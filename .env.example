# =============================================================================
# OpenAdult — 環境変数サンプル / Environment variable example
# -----------------------------------------------------------------------------
# 使い方 / Usage:
#   cp .env.example .env   then fill in the values below.
# サーバ起動時に dotenv が自動で .env を読み込みます（`source .env` は使わない）。
# The server auto-loads .env via `import "dotenv/config"` — do NOT `source` it
# (JSON values like DOMAIN_POOL break shell sourcing).
# 本番用の完全な説明は deploy/docs/env-template.md を参照。
# =============================================================================

# === 必須 / Required ===
# データベース接続 (MySQL / TiDB / MariaDB)。ローカル開発例:
#   DATABASE_URL=mysql://root@127.0.0.1:3307/openadult
# 本番 (TLS) 例:
#   DATABASE_URL=mysql://user:password@host:3306/openadult?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://root@127.0.0.1:3307/openadult

# Cookie/JWT 署名キー (32文字以上推奨)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# === Manus OAuth (ログイン機能を使う場合に必須 / required for login) ===
# 空のままでもサーバは起動します（ログイン関連の機能のみ無効）。
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# === Manus Forge / LLM (AI チャット・人脸検索を使う場合に必須) ===
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
HERETIC_LLM_MODEL=

# === S3 / ストレージ (アップロード・配信を使う場合に必須) ===
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=
# HLS_MODE: 開発は pseudo、本番は real
HLS_MODE=pseudo

# === 任意 / Optional ===
# ADMIN_API_KEY=
# ALLOWED_ORIGINS=openadult.com,cdn.openadult.com
# CF_API_TOKEN=
# CF_ZONE_ID=
# TG_BOT_TOKEN=
# TG_CHANNEL_ID=
# DOMAIN_POOL=["openadult.com","openadult.net"]
# PORT=3000

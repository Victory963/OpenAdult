{
  // 仓库级 VS Code 设置 —— 新机器 clone 后即刻生效，无需手动配置。

  // 使用仓库内锁定的 TypeScript 5.9.3，而不是 VS Code 内置版本，
  // 避免不同机器 TS 版本不一致导致的报错差异。
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // 保存时用 Prettier 格式化（配置读取根目录 .prettierrc）
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // 自动整理 import（仅在保存时，不改动其他代码）
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // import 自动补全时优先使用相对路径以外的路径别名（@/ → client/src, @shared/ → shared）
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // Tailwind CSS 4：让 IntelliSense 在 cn()/clsx()/cva() 里也能补全类名
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
  ],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  // 搜索/文件树里隐藏构建产物与依赖，避免误改 dist 下的文件
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true
  },
  "files.exclude": {
    "**/.pnpm-store": true
  },

  // 统一换行符为 LF（.prettierrc 也设了 endOfLine: lf）——
  // Windows 新机器上尤其重要，否则 shell 脚本会因 CRLF 无法执行。
  "files.eol": "\n",

  // 本仓库注释以简体中文为主，关闭拼写检查噪音
  "editor.unicodeHighlight.ambiguousCharacters": false
}
